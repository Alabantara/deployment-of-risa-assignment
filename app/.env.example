# Supabase (Optional — runs in Local Demo Mode if omitted, persists to Postgres when configured)
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# AI Copilot Provider (Pick gemini_lite or groq; you can also paste keys in the UI Settings drawer)
VITE_DEFAULT_LLM_PROVIDER=gemini_lite
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-2.5-flash-lite
VITE_GROQ_API_KEY=
VITE_GROQ_MODEL=llama-3.3-70b-versatile
